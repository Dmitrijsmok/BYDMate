PORT=8787
DB_PATH=./bydmate-alice.sqlite
BYDMATE_API_KEY=replace-with-a-long-random-key
YANDEX_CLIENT_ID=replace-with-your-yandex-oauth-client-id
ALICE_DIALOG_TOKEN=replace-with-a-long-random-dialog-token
# compact = battery card only; legacy = old full Smart Home card set; none = no cards
ALICE_SMART_HOME_CARDS=full
# A queued command older than this is expired instead of run (default 30000 ms; BYDMate drops
# commands older than 30 s on its side too)
# ALICE_COMMAND_TTL_MS=30000
